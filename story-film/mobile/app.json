{
  "expo": {
    "name": "Reelkar",
    "slug": "reelkar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reelkar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.reelkar",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.reelkar",
      "adaptiveIcon": {
        "backgroundColor": "#2a1235",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Reelkar"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff7ee",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#150a1a",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Reelkar opens your gallery so you can pick a video to edit.",
          "savePhotosPermission": "Reelkar saves the reels you make to your Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Reelkar opens your gallery so you can pick a video to edit.",
          "cameraPermission": "Reelkar films a clip of you to put a song under. It's used only when you tap Film yourself.",
          "microphonePermission": "Reelkar records your humming, singing or voice to make a song."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Reelkar records your humming, singing or voice to make a song."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Reelkar records your humming, singing or voice to make a song.",
          "speechRecognitionPermission": "Reelkar understands what you said on your phone before sending it.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/with-app-intents",
      "expo-apple-authentication",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1da35408-b35f-4d76-b697-769534eeaaa5"
      }
    },
    "owner": "rajnish.official",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/1da35408-b35f-4d76-b697-769534eeaaa5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": { "expo-channel-name": "production" }
    }
  }
}
