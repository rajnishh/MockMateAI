{
  "name": "story-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Story-to-film MVP: story -> script -> keyframes -> clips -> narration + music -> 9:16 film",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema": "npx auth@latest generate --config src/lib/auth.ts --output src/lib/db/auth-schema.ts --yes",
    "billing:plans": "tsx --env-file=.env scripts/create-razorpay-plans.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/expo": "^1.7.14",
    "@contentauth/c2pa-node": "^0.9.9",
    "@napi-rs/canvas": "^1.0.13",
    "better-auth": "^1.7.14",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
