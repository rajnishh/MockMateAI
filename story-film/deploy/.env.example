# Reelkar beta server settings. Copy to deploy/.env and fill in. Never commit the real file.
# Generate secrets with: openssl rand -base64 32

# ---- Required ----
# The server's public name; point its DNS A record at this machine first.
DOMAIN=api.example.com
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
# Free AI for scripts and pictures (Cloudflare dashboard > AI > Workers AI > API token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Sign-in ----
# "console" prints OTP codes in the worker/web logs (fine for a small beta: read them with
# `docker compose logs web | grep -i otp`). "msg91" sends real SMS (needs DLT registration).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Google sign-in and YouTube posting (Google Cloud > Credentials > OAuth client, web).
# Redirect URIs: https://DOMAIN/api/auth/callback/google and https://DOMAIN/api/connect/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Posting ----
# Instagram (Meta App Dashboard > Instagram > API setup with Instagram login).
# Redirect URI: https://DOMAIN/api/connect/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Optional ----
# Better scripts and ideas (otherwise Workers AI Llama).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Premium AI animation, songs, Arabic narration.
FAL_KEY=
VIDEO_MODEL=wan
# Marathi, Bengali, Tamil and Telugu narration.
SARVAM_API_KEY=
KOKORO_VOICE=af_heart
FREE_FILMS_PER_WEEK=3
# C2PA Content Credentials (file paths inside the container or PEM text).
C2PA_CERT_CHAIN=
C2PA_PRIVATE_KEY=
C2PA_TSA_URL=
# Payments stay off during the free beta.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
