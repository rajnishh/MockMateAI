# Redis for the BullMQ job queue
REDIS_URL=redis://localhost:6379

# LLM for script + shot list (OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# fal.ai for keyframes (Nano Banana 2) and image-to-video (Wan / Kling)
FAL_KEY=
VIDEO_MODEL=wan
# Override the fal model IDs if they differ from the defaults in src/lib/providers/fal.ts
# FAL_IMAGE_MODEL_ID=
# FAL_IMAGE_EDIT_MODEL_ID=
# FAL_WAN_MODEL_ID=
# FAL_KLING_MODEL_ID=

# Self-hosted audio (Kokoro-FastAPI and an ACE-Step HTTP server)
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart
ACESTEP_URL=http://localhost:8001

# Where finished films and intermediate files are written
OUTPUT_DIR=./output
