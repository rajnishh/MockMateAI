# free: Cloudflare Workers AI (script + images) + pan-and-zoom video, ~$0 per video
# paid: OpenRouter (script) + fal.ai (Nano Banana 2 images, Wan/Kling video)
PROVIDER_MODE=free

# Free mode: a free Cloudflare account (Workers AI: 10,000 neurons/day free)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CF_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Paid mode
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
FAL_KEY=
VIDEO_MODEL=wan
# FAL_IMAGE_MODEL_ID=
# FAL_IMAGE_EDIT_MODEL_ID=
# FAL_WAN_MODEL_ID=
# FAL_KLING_MODEL_ID=

# Both modes
REDIS_URL=redis://localhost:6379
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart
# Optional background music from a self-hosted ACE-Step server; without it videos have narration only
# ACESTEP_URL=http://localhost:8001
FREE_FILMS_PER_WEEK=3
OUTPUT_DIR=./output
