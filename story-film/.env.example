# Standard videos (free weekly, then 1 credit): Cloudflare Workers AI images
# + pan-and-zoom. A free Cloudflare account works (10,000 neurons/day).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CF_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional: OpenRouter for scripts and ideas (otherwise Workers AI Llama is used)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Premium "AI animation" videos and Song Studio (both paid with credits) appear when FAL_KEY is set
FAL_KEY=
VIDEO_MODEL=wan
# FAL_IMAGE_MODEL_ID=
# FAL_IMAGE_EDIT_MODEL_ID=
# FAL_WAN_MODEL_ID=
# FAL_KLING_MODEL_ID=

# Database and sign-in
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storyfilm
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google sign-in (Google Cloud Console > Credentials > OAuth client, web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube publishing uses the same Google OAuth client. Also add the redirect URI
# <BETTER_AUTH_URL>/api/connect/youtube/callback, enable "YouTube Data API v3",
# and add the youtube.upload + youtube.readonly scopes to the consent screen.
# Encrypts stored channel tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Phone OTP: "console" prints codes in the server log; "msg91" sends real SMS
# (needs a DLT-registered sender and OTP template, required for SMS in India)
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=

# C2PA Content Credentials (marks every video and song as AI-generated inside the file).
# Dev: run scripts/dev-c2pa-cert.sh and paste its two lines here. Production needs a
# certificate from a CA on the C2PA trust list. Values may be file paths or PEM text.
C2PA_CERT_CHAIN=
C2PA_PRIVATE_KEY=
# Timestamp authority so signatures outlive the certificate, e.g. http://timestamp.digicert.com
C2PA_TSA_URL=

# Payments (Razorpay). INR covers UPI, cards and netbanking; USD needs
# International Payments enabled on the Razorpay account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: <BETTER_AUTH_URL>/api/webhooks/razorpay, events: order.paid,
# payment.captured and all subscription.* events
RAZORPAY_WEBHOOK_SECRET=
# Monthly plan ids: run `npm run billing:plans` once and paste its output here
# RAZORPAY_PLAN_CREATOR_MONTHLY_INR=
# RAZORPAY_PLAN_CREATOR_MONTHLY_USD=
# RAZORPAY_PLAN_PRO_MONTHLY_INR=
# RAZORPAY_PLAN_PRO_MONTHLY_USD=

# Infrastructure
REDIS_URL=redis://localhost:6379
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart
# Optional background music from a self-hosted ACE-Step server; without it videos have narration only
# ACESTEP_URL=http://localhost:8001
FREE_FILMS_PER_WEEK=3
OUTPUT_DIR=./output
# Caption fonts (bundled)
FONTS_DIR=./assets/fonts
